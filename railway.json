{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd bridgebase && npm install && npm run build",
    "watchPatterns": ["bridgebase/**"]
  },
  "deploy": {
    "startCommand": "cd bridgebase && npm run start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

