# Google Maps (browser) + Places (server routes use non-public name)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Firebase (Auth + Firestore + optional Analytics / Realtime DB URL)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — Realtime Database (from Firebase console)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# Optional — Analytics (initialized in lib/firebase.ts when set)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# AI chat (optional — without it, API returns a static fallback)
OPENAI_API_KEY=

# Resource request emails (optional)
RESEND_API_KEY=
RESOURCE_REQUEST_TO_EMAIL=
